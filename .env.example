# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# When running via Docker Compose, host is "db" (the service name).
DATABASE_URL=postgresql://postgres:postgres@db:5432/pdf_assistant

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Service URLs ──────────────────────────────────────────────────────────────
# Used by the Streamlit frontend to reach the FastAPI backend.
# Docker Compose: http://backend:8000  |  Local dev: http://localhost:8000
BACKEND_URL=http://backend:8000

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
