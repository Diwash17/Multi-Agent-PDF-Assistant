FROM python:3.11-slim

# Install system dependencies needed by psycopg2 and PyMuPDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency manifest first (layer cache)
COPY pyproject.toml .
COPY .python-version .

# Install dependencies into the system Python (no venv needed inside Docker)
RUN uv pip install --system --no-cache -r <(uv pip compile pyproject.toml 2>/dev/null || echo "") 2>/dev/null || \
    uv pip install --system --no-cache \
        "fastapi>=0.111.0" \
        "uvicorn[standard]>=0.29.0" \
        "python-multipart>=0.0.9" \
        "langchain>=0.2.0" \
        "langgraph>=0.1.0" \
        "langchain-google-genai>=1.0.0" \
        "langchain-community>=0.2.0" \
        "pymupdf>=1.24.0" \
        "sqlalchemy>=2.0.0" \
        "alembic>=1.13.0" \
        "pgvector>=0.3.0" \
        "psycopg2-binary>=2.9.9" \
        "pydantic-settings>=2.2.0" \
        "python-dotenv>=1.0.0" \
        "httpx>=0.27.0" \
        "tenacity>=8.3.0"

# Copy application code
COPY backend/ ./backend/
COPY alembic/ ./alembic/ 2>/dev/null || true
COPY alembic.ini . 2>/dev/null || true

EXPOSE 8000

CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
